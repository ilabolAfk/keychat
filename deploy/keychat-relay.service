[Unit]
Description=KeyChat relay (WebSocket hub for P2P messaging/calls)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Замените User на вашего пользователя на RPi (обычно pi)
User=pi
WorkingDirectory=/home/pi/keychat-relay
ExecStart=/usr/bin/python3 /home/pi/keychat-relay/relay.py
# Порт можно задать отдельно; по умолчанию relay слушает 8765
Environment=KEYCHAT_RELAY_PORT=8765
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target